{
  "name": "fukuoka-asobi",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "admin"
  ],
  "scripts": {
    "commit": "cz",
    "dev:frontend": "npm run dev -w frontend",
    "dev:admin": "npm run dev -w admin",
    "build:frontend": "npm run build -w frontend",
    "build:admin": "npm run build -w admin",
    "lint:frontend": "npm run lint -w frontend",
    "lint:admin": "npm run lint -w admin",
    "storybook:frontend": "npm run storybook -w frontend",
    "storybook:admin": "npm run storybook -w admin",
    "build-storybook:frontend": "npm run build-storybook -w frontend",
    "build-storybook:admin": "npm run build-storybook -w admin",
    "chromatic:frontend": "npm run chromatic -w frontend",
    "chromatic:admin": "npm run chromatic -w admin",
    "deploy:frontend": "npm run build:frontend",
    "deploy:admin": "npm run build:admin"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "graphql": "^16.11.0",
    "next": "15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.8.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/experimental-nextjs-vite": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chromatic": "^13.3.4",
    "commitizen": "^4.3.0",
    "cz-git": "^1.12.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.8.2",
    "wrangler": "^4.47.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}