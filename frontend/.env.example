# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/apis/credentials
# Note: The placeholder below is for a Web Application OAuth client ID (suffix: .apps.googleusercontent.com).
# For iOS or Android, use the appropriate client ID format as provided by Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GraphQL API Endpoint
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:3000/graphql
