# 本番環境用環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env

# Rails マスターキー（config/master.key の内容）
# アプリケーションの secrets を復号化するために必要
RAILS_MASTER_KEY=your_rails_master_key_here

# Rails シークレットキーベース
# 以下のコマンドで生成: bundle exec rails secret
SECRET_KEY_BASE=your_secret_key_base_here

# データベース設定
DB_USERNAME=fukuoka_asobi
DB_PASSWORD=your_secure_db_password_here
DB_NAME=fukuoka_asobi_production
DB_ROOT_PASSWORD=your_secure_root_password_here

# MinIO 設定（オブジェクトストレージ）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
