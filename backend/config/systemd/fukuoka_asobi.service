[Unit]
Description=Fukuoka Asobi Rails Application (Puma)
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/fukuoka_asobi/current

# 環境変数
Environment=RAILS_ENV=production
Environment=PORT=3000

# 環境変数ファイルを読み込む
EnvironmentFile=/var/www/fukuoka_asobi/shared/.env.production

# Puma の起動コマンド
ExecStart=/home/deploy/.rbenv/shims/bundle exec puma -C config/puma.rb

# 再起動設定
Restart=always
RestartSec=10

# 標準出力・エラー出力をsyslogに送る
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=fukuoka_asobi

# プロセスの制限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
