# 本番環境用環境変数テンプレート
# このファイルをコピーして /var/www/fukuoka_asobi/shared/.env.production を作成してください
# 
# コピー方法:
# cp backend/config/.env.production.example /var/www/fukuoka_asobi/shared/.env.production
# 
# その後、各値を実際の値に置き換えてください

# Rails 設定
RAILS_ENV=production
RAILS_MASTER_KEY=your_master_key_here_generate_with_rails_secret

# データベース設定（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=fukuoka_asobi
DB_PASSWORD=your_strong_password_here
DB_NAME=fukuoka_asobi_production

# Puma 設定
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# ActiveStorage 設定
# ローカルディスクを使用する場合
ACTIVE_STORAGE_SERVICE=local

# 将来 S3 に移行する場合は以下を設定
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-northeast-1
# AWS_BUCKET=fukuoka-asobi-production

# アプリケーション設定
APP_HOST=your-domain.example.com
FRONTEND_URL=https://your-frontend-domain.example.com
ADMIN_URL=https://your-admin-domain.example.com

# Google OAuth 設定
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe 設定（決済機能を使う場合）
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# その他
RAILS_LOG_LEVEL=info
